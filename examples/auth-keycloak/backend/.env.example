# Local-only sample. Do not commit real credentials.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/DATABASE"
REDIS_URL="redis://:PASSWORD@localhost:6379"
# Production: tro toi Redis queue rieng (AOF, maxmemory-policy=noeviction).
# Neu bo trong, queue tam thoi dung chung REDIS_URL de tuong thich dev/cum hien tai.
REDIS_QUEUE_URL="redis://:PASSWORD@localhost:6379"
EMQX_URL="mqtt://localhost:1883"
BACKEND_MQTT_SECRET="replace-with-a-long-random-secret"

# Shared only by EMQX Webhook and Backend. Required for v1/gateway/* ingestion.
EMQX_WEBHOOK_SECRET="replace-with-a-different-long-random-secret"

# Redis Streams durable queue
REDIS_STREAM_SHARDS="16"
REDIS_STREAM_GROUP="postgres-writers-v1"
REDIS_STREAM_MAX_RETRIES="5"
REDIS_STREAM_CLAIM_IDLE_MS="30000"
REDIS_STREAM_CLAIM_INTERVAL_MS="30000"
REDIS_STREAM_MAX_LENGTH="1000000"
TELEMETRY_BATCH_SIZE="1000"
TELEMETRY_PROCESS_INTERVAL_MS="200"
MAX_MQTT_PAYLOAD_BYTES="65536"
MAX_TELEMETRY_KEYS="256"

# Credential cache va telemetry lifecycle
DEVICE_CREDENTIAL_CACHE_TTL_SECONDS="300"
TELEMETRY_RETENTION_DAYS="0"
TELEMETRY_RETENTION_INTERVAL_MS="21600000"
TELEMETRY_RETENTION_DELETE_BATCH="50000"
